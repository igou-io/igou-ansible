---
profile: production

# Changelog fragment names can contain "playbook" without being Ansible plays.
kinds:
  - vars: molecule/*/overrides.yml
  - yaml: "**/changelogs/fragments/*.{yaml,yml}"

# Syntax-check fixtures only: restore deliberately has no operational target default.
extra_vars:
  ansible_limit: localhost

# Exclude files that reference roles/collections not installable in this environment
exclude_paths:
  - .venv/
  - playbooks/openshift/casval-orchestrator-workflow.yml
  - playbooks/devenv/restore-orchestrator-workflow.yml
  - .ansible/
  - .tekton/  # Tekton/PaC manifests — Kubernetes CRDs, not Ansible content
  - playbooks/netbox/  # davidwittman.redis
  # `make ao-export` output: an Automation Orchestrator workflow definition, not
  # a playbook. It lives under playbooks/ to sit next to the playbooks its steps
  # dispatch, so ansible-lint would otherwise try to parse it as Ansible content.
  - playbooks/linux/disk/orchestrator-workflow.yml  # AO workflow export
  - playbooks/rhel/rhsm-system-register.yml  # redhat.rhel_system_roles.rhc
  - playbooks/taint-nodes.yaml  # node_taint role
  - playbooks/zfs/  # ansible-zfs
  - roles/kubevirt_provision_survey/  # infra.controller_configuration.job_templates
  - roles/kubevirt_vm_snapshot/  # short interface + internal register/set_fact vars intentionally unprefixed for ergonomic CLI/extra_vars; lint logic via `ansible-lint -x var-naming`
  - roles/kubevirt_vm_provision/  # same: short vm_* interface + internal _kvp_* accumulators; lint logic via `ansible-lint -x var-naming`
